# RustPacker All-in-One Container
# Cross-compile Windows payloads from any platform using only Podman or Docker
#
# This container includes:
# - Rust stable toolchain with Windows cross-compilation target
# - Mingw-w64 toolchain for Windows cross-compilation
# - Pre-built RustPacker binary
# - All templates and dependencies
#
# Usage:
#   podman run --rm -v $(pwd):/workdir ghcr.io/nariod/rustpacker:latest \
#       --shellcode-path /workdir/shellcode.bin \
#       --format exe \
#       --execution nt-create-remote-thread \
#       --encryption xor \
#       --output /workdir/payload.exe

FROM docker.io/library/rust:slim as builder

# Install Windows cross-compilation toolchain
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    g++-mingw-w64-x86-64 \
    gcc-mingw-w64-x86-64 \
    binutils-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

# Add Windows GNU target for cross-compilation
RUN rustup target add x86_64-pc-windows-gnu

# Create and set working directory
WORKDIR /app

# Copy project files (.dockerignore excludes target/, .git/, etc.)
COPY . ./

# Build the RustPacker CLI for the container's host target (Linux).
# Windows cross-compilation flags are applied at runtime by entrypoint.sh
# when generating payloads; the host build must not use crt-static because
# it breaks proc-macro crates (clap_derive, thiserror-impl, ...).
RUN CARGO_TERM_COLOR=always cargo build --release --locked --bin RustPacker

# Final stage - runtime image
FROM docker.io/library/debian:stable-slim

# Install mingw-w64 toolchain, CA certificates, and build tools (needed for SSL and compilation)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    g++-mingw-w64-x86-64 \
    gcc-mingw-w64-x86-64 \
    binutils-mingw-w64-x86-64 \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy Rust toolchain from builder stage (rustc/cargo/rustup live in /usr/local/cargo/bin)
COPY --from=builder /usr/local/rustup /usr/local/rustup
COPY --from=builder /usr/local/cargo /usr/local/cargo

# Copy the pre-built RustPacker binary
COPY --from=builder /app/target/release/RustPacker /usr/local/bin/rustpacker

# Copy all project files (templates, source code)
COPY --from=builder /app /app

# Set working directory
WORKDIR /app

# The x86_64-pc-windows-gnu target is already installed in the builder
# and copied via /usr/local/rustup above, so no rustup call is needed here.

# Create shared directory for generated files
RUN mkdir -p /app/shared

# Set environment variables for cross-compilation
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH="/usr/local/cargo/bin:/usr/local/rustup/shims:${PATH}"
ENV CFLAGS_x86_64_pc_windows_gnu="-lrt"
ENV LDFLAGS_x86_64_pc_windows_gnu="-lrt"
# Applied when RustPacker compiles Windows payloads from inside the
# container via local cargo (the host CLI build in the builder stage above
# must NOT use crt-static: it breaks proc-macro crates like clap_derive).
ENV RUSTFLAGS="-C target-feature=+crt-static"

# Copy entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]
CMD ["--help"]

# Metadata
LABEL maintainer="Nariod"
LABEL description="RustPacker - Cross-compile Windows shellcode loaders from any platform"
LABEL version="3.0.0"
LABEL org.opencontainers.image.source="https://github.com/Nariod/RustPacker"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="RustPacker"
LABEL org.opencontainers.image.authors="Nariod"